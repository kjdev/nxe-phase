# nxe-phase/config.ngx — nginx build configuration
#
# Sourced by the parent module's `config` file.
#
# Prerequisites the caller MUST set before sourcing this file:
#
#   nxe_phase_dir   absolute path to this submodule
#   nxe_phase_tag   short token unique to the calling module (e.g. its
#                   own module name).  nxe-phase is vendored source, so
#                   every consumer compiles its own copy of
#                   nxe_phase.c; the tag becomes part of the compiled
#                   ngx_module_t symbol name
#                   (nxe_phase_order_module_$nxe_phase_tag) so that
#                   several copies can coexist in one nginx binary
#                   without a link-time name collision.  The tag is
#                   injected through a per-consumer wrapper .c
#                   generated under $NGX_OBJS (not through CFLAGS,
#                   which auto/make writes out once as a single global
#                   Makefile variable shared by every addon source in
#                   the build, so a second consumer's tag would
#                   silently overwrite the first's for every
#                   translation unit).
#
# After sourcing, $nxe_phase_module_{name,deps,srcs,incs,libs} are
# populated and should be appended to the parent module's ngx_module_*
# lists.
#
# IMPORTANT: unlike nxe-json/nxe-cedar/nxe-jwx, nxe-phase compiles its
# own ngx_module_t.  $nxe_phase_module_name MUST be appended to the
# parent's $ngx_module_name string as the *second or later* token (the
# first token is what auto/module uses as the built .so's file name),
# e.g.:
#
#   ngx_module_name="ngx_http_my_module $nxe_phase_module_name"

if [ -z "$nxe_phase_dir" ]; then
    echo "$0: error: nxe_phase_dir is not set" >&2
    exit 1
fi

if [ -z "$nxe_phase_tag" ]; then
    echo "$0: error: nxe_phase_tag is not set" >&2
    exit 1
fi

# $nxe_phase_tag is spliced into a C macro (NXE_PHASE_TAG) and a
# generated directory name, so it must be a valid C identifier.
case "$nxe_phase_tag" in
    [A-Za-z_]*) ;;
    *)
        echo "$0: error: nxe_phase_tag must start with a letter or underscore: $nxe_phase_tag" >&2
        exit 1
        ;;
esac

case "$nxe_phase_tag" in
    *[!A-Za-z0-9_]*)
        echo "$0: error: nxe_phase_tag must contain only letters, digits, and underscores: $nxe_phase_tag" >&2
        exit 1
        ;;
esac

if [ -z "$NGX_OBJS" ]; then
    echo "$0: error: NGX_OBJS is not set" >&2
    exit 1
fi

# The include below is resolved relative to the generated file under
# $NGX_OBJS, so the vendored path has to be absolute.
if ! nxe_phase_abs_dir=$(cd "$nxe_phase_dir" && pwd); then
    echo "$0: error: nxe_phase_dir is not a valid directory: $nxe_phase_dir" >&2
    exit 1
fi
nxe_phase_gen_dir="$NGX_OBJS/nxe_phase_$nxe_phase_tag"

if ! mkdir -p "$nxe_phase_gen_dir"; then
    echo "$0: error: failed to create $nxe_phase_gen_dir" >&2
    exit 1
fi

if ! cat > "$nxe_phase_gen_dir/nxe_phase.c" <<NXE_PHASE_END
#define NXE_PHASE_TAG $nxe_phase_tag
#include "$nxe_phase_abs_dir/src/nxe_phase.c"
NXE_PHASE_END
then
    echo "$0: error: failed to generate $nxe_phase_gen_dir/nxe_phase.c" >&2
    exit 1
fi

nxe_phase_module_name="nxe_phase_order_module_$nxe_phase_tag"
nxe_phase_module_deps="$nxe_phase_abs_dir/src/nxe_phase.h $nxe_phase_abs_dir/src/nxe_phase.c"
nxe_phase_module_srcs="$nxe_phase_gen_dir/nxe_phase.c"
nxe_phase_module_incs="$nxe_phase_abs_dir/src"
nxe_phase_module_libs=""
